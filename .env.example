# StreamNet — Environment Variables
# Copy this file to .env and fill in your values

# Email Service (SMTP)
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-smtp-app-password

# AWS S3 (Image Service)
AWS_ACCESS_KEY=your-aws-access-key-id
AWS_SECRET_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=streamnet-storage

# Google APIs (Post Service — YouTube link previews)
GOOGLE_API_KEY=your-google-api-key

# pgAdmin (local development)
PGADMIN_DEFAULT_EMAIL=admin@streamnet.local
PGADMIN_DEFAULT_PASSWORD=admin

# Infrastructure hosts (override for local dev)
EUREKA_HOST=localhost
CONFIG_SERVER_HOST=localhost
ZIPKIN_HOST=localhost
DATASOURCE_HOST=localhost
RABBITMQ_HOST=localhost
